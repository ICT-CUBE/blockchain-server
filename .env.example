# Copy to .env and fill in real values. Never commit .env — see .gitignore.
# This file is extended by later tasks (TASK-05 Web3Auth, TASK-10 RPC/signers, TASK-12 webhook,
# TASK-13 Pinata/NFT.Storage). TASK-01/04/06 need the blocks below.

# ---------------------------------------------------------------------------
# Server bootstrap (TASK-01)
# ---------------------------------------------------------------------------
NODE_ENV=development
# Matches `docs/5. 검증 계획서.md` §3's test-instance assumption and its curl examples.
PORT=3100

# Selects which contracts/cube-nft/deployments/<network>.json artifact the server loads.
# `localhost` matches README's separate `npm run node` + `deploy:localhost` startup flow.
# Other values include hardhatMainnet (in-process deploy/test) and amoy (Polygon Amoy testnet).
CUBE_NFT_NETWORK=localhost

# Optional. Overrides where deployment artifacts are read from. Leave unset to use the
# @cube-nft/contracts workspace package's own deployments/ directory.
# CUBE_NFT_DEPLOYMENTS_DIR=

# ---------------------------------------------------------------------------
# Blockchain Server's own MySQL (TASK-04) — never the Backend's database.
# Matches docker-compose.yml's `mysql` service by default.
# The server pins every connection's session to time_zone='+00:00' itself, so the host MySQL's
# own time zone (SYSTEM/KST/…) does not matter — no `default-time-zone` config needed.
# ---------------------------------------------------------------------------
DATABASE_URL=mysql://cube_nft:cube_nft@127.0.0.1:3306/cube_nft
# Azure Database for MySQL requires TLS. Keep false for the local Docker MySQL service.
DATABASE_SSL_ENABLED=false
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Backend -> Blockchain Server request authentication (TASK-06).
# Secrets are base64url, decoding to >=32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotate HMAC_INBOUND_KEY_* every 90 days; keep the outgoing key as the PREVIOUS_* pair for the
# overlap window so both are accepted, then remove it.
# ---------------------------------------------------------------------------
HMAC_INBOUND_KEY_ID=backend-v1
HMAC_INBOUND_KEY_SECRET=
# HMAC_INBOUND_PREVIOUS_KEY_ID=
# HMAC_INBOUND_PREVIOUS_KEY_SECRET=

# ARZONE approval JWT (HS256, <=30min). A separate key from the HMAC keys above.
APPROVAL_JWT_SECRET=
APPROVAL_JWT_ISSUER=arzone-backend
APPROVAL_JWT_AUDIENCE=arzone-blockchain-server

# ---------------------------------------------------------------------------
# MPC custodial wallet (TASK-05). "fake" (default) needs nothing below — it's a deterministic
# local adapter. Switch to "web3auth" only once WEB3AUTH_AUTH_CONNECTION_ID and
# WEB3AUTH_JWT_SIGNING_PRIVATE_KEY are both set (see Web3AuthAdapter for what those are).
# ---------------------------------------------------------------------------
CUSTODIAL_WALLET_PROVIDER=fake
# WEB3AUTH_CLIENT_ID=
WEB3AUTH_NETWORK=sapphire_devnet
WEB3AUTH_CHAIN_ID=80002
# WEB3AUTH_RPC_TARGET=
# WEB3AUTH_AUTH_CONNECTION_ID=
# WEB3AUTH_JWT_SIGNING_PRIVATE_KEY=
# WEB3AUTH_JWT_SIGNING_KEY_ID=

# ---------------------------------------------------------------------------
# CubeNFT contract deployment roles (contracts/cube-nft/scripts/deploy.ts)
# Required only when deploying to Amoy/Mainnet; local deploys fall back to Hardhat dev signers.
# ---------------------------------------------------------------------------
# CUBE_NFT_ADMIN_ADDRESS=
# CUBE_NFT_MINTER_ADDRESS=
# CUBE_NFT_RELAYER_ADDRESS=
# CUBE_NFT_PAUSER_ADDRESS=

# Governance handoff (`contracts/cube-nft/scripts/transfer-governance.ts`). Mainnet enforces the
# 48-hour delay. Proposers should be the governance Safe; executors default to proposers.
# GOVERNANCE_TARGET=rehearsal
# CUBE_NFT_TIMELOCK_PROPOSER_ADDRESSES=
# CUBE_NFT_TIMELOCK_EXECUTOR_ADDRESSES=
# CUBE_NFT_TIMELOCK_MIN_DELAY_SECONDS=172800

# ---------------------------------------------------------------------------
# Amoy RPC (contracts/cube-nft/hardhat.config.ts) — Primary Infura, Backup Polygon public RPC
# ---------------------------------------------------------------------------
# AMOY_RPC_URL_PRIMARY=
# AMOY_DEPLOYER_PRIVATE_KEY=
# Acceptance-script-only overrides (`npm run test:amoy`):
# AMOY_ACCEPTANCE_TOKEN_ID=
# AMOY_ACCEPTANCE_REPORT_DIR=reports

# ---------------------------------------------------------------------------
# TASK-10 transaction submission / TASK-11 confirmation. On local Hardhat networks
# (hardhatMainnet/hardhatOp), RPC/signer vars fall back to well-known Hardhat dev accounts — only
# RAW_TX_ENCRYPTION_KEY is required everywhere. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Non-local networks (amoy) must set TRANSACTION_RPC_URL_PRIMARY, MINT_SIGNER_PRIVATE_KEY, and
# RELAYER_SIGNER_PRIVATE_KEY explicitly.
# ---------------------------------------------------------------------------
RAW_TX_ENCRYPTION_KEY=
# TRANSACTION_RPC_URL_PRIMARY=
# TRANSACTION_RPC_URL_BACKUP=
# MINT_SIGNER_PRIVATE_KEY=
# RELAYER_SIGNER_PRIVATE_KEY=
SUBMISSION_POLL_INTERVAL_MS=2000
# 테스트 전용 (T10 process-kill 검증). `1`/`true` AND `NODE_ENV=test`가 모두 참일 때만
# 활성화된다 — submit()가 서명한 attempt를 커밋만 하고 broadcast하지 않으며 복구 워커도 멈춘다.
# 운영 환경(`NODE_ENV`≠test)에서는 loadConfig가 무시하므로 절대 켜지지 않는다. 평소에는 설정하지 말 것.
# SUBMISSION_PAUSE_BEFORE_BROADCAST=0
RBF_THRESHOLD_MS=300000
RBF_MAX_ATTEMPTS=3
RBF_FEE_BUMP_PERCENT=15
CONFIRMATION_BLOCKS_REQUIRED=5
RECONCILIATION_POLL_INTERVAL_MS=5000
RECONCILIATION_BATCH_SIZE=20

# TASK-08/09: how long a freshly-signed OwnerConsent stays valid.
OWNER_CONSENT_DEADLINE_SECONDS=600

# TASK-12: outbound completion webhook to Backend. Point NOTIFICATION_CALLBACK_URL at the Mock
# Receiver for local dev/testing (npm run mock-receiver --workspace=server):
#   http://127.0.0.1:4100/webhook
# HMAC_OUTBOUND_KEY_SECRET must match the Mock Receiver's own MOCK_RECEIVER_HMAC_SECRET.
NOTIFICATION_CALLBACK_URL=
HMAC_OUTBOUND_KEY_ID=outbound-v1
HMAC_OUTBOUND_KEY_SECRET=
NOTIFICATION_TIMEOUT_MS=10000
NOTIFICATION_MAX_AUTO_RETRIES=6
NOTIFICATION_BASE_BACKOFF_MS=2000
NOTIFICATION_MAX_BACKOFF_MS=300000
NOTIFICATION_POLL_INTERVAL_MS=2000
NOTIFICATION_BATCH_SIZE=20

# TASK-13: metadata pinning/preservation. "fake" (default) needs no credentials — a deterministic
# local stand-in good enough to exercise the whole pipeline (dependency tracking, READY gating,
# tokenURI). Switch to "real" only once PINATA_JWT and FILEBASE_PIN_TOKEN are both set.
#   - Pinata: hot pinning (uploads the bytes).
#   - Filebase: long-term preservation by reference, via the standard IPFS Pinning Service API.
#     FILEBASE_PIN_TOKEN is a per-bucket access token (Filebase console → Access Keys → IPFS
#     Pinning Service). Replaced NFT.Storage, whose Classic pinning API was decommissioned 2024-06-30.
METADATA_PROVIDER=fake
# PINATA_JWT=
# FILEBASE_PIN_TOKEN=
# FILEBASE_PIN_ENDPOINT=https://api.filebase.io/v1/ipfs
METADATA_HTTP_TIMEOUT_MS=15000
# Preservation is asynchronous (Filebase returns 202 "queued"). A background worker polls pin
# status and re-claims rows stuck SUBMITTING (submitter crashed mid-request).
METADATA_PRESERVATION_STALE_CLAIM_MS=60000
METADATA_PRESERVATION_POLL_INTERVAL_MS=30000
METADATA_PRESERVATION_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# TASK-14: structured logging, audit/failure trail, and operator query authentication.
# HMAC_OPERATOR_KEY_* is a SEPARATE key pair from HMAC_INBOUND_KEY_* above — it gates only the
# read-only GET /internal/v1/audit/* endpoints, so the credential Backend uses to create Operations
# can never also read the audit trail. Generate a secret the same way as HMAC_INBOUND_KEY_SECRET.
# ---------------------------------------------------------------------------
LOG_LEVEL=log
LONG_PENDING_THRESHOLD_MS=1800000
HMAC_OPERATOR_KEY_ID=operator-v1
HMAC_OPERATOR_KEY_SECRET=
# HMAC_OPERATOR_PREVIOUS_KEY_ID=
# HMAC_OPERATOR_PREVIOUS_KEY_SECRET=

# ---------------------------------------------------------------------------
# 2026-08-28 검증 remediation (docs/검증-종합-문제-원인-개선안.md)
# ---------------------------------------------------------------------------
# D1: a SIGNED attempt whose broadcast keeps failing transiently is retried with exponential
# backoff (base = SUBMISSION_POLL_INTERVAL_MS) at most BROADCAST_MAX_RETRIES times, then the
# Operation goes to REVIEW_REQUIRED with a BROADCAST_RETRY_EXHAUSTED failure record.
BROADCAST_MAX_RETRIES=30
BROADCAST_MAX_BACKOFF_MS=60000
# D1: an ACTIVE nonce reservation with no committed attempt older than this is treated as orphaned
# (process died between reserve and commit) and re-used to fill the gap.
NONCE_RESERVATION_LEASE_MS=60000
# Metadata: Blockchain Server pins the image itself, so it bounds the decoded bytes it accepts.
METADATA_IMAGE_MAX_BYTES=2097152
