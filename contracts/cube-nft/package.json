{
  "name": "@cube-nft/contracts",
  "private": true,
  "version": "0.1.0",
  "description": "ARZONE CUBE NFT smart contracts (Hardhat 3, UUPS, ERC-721)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "lint": "solhint 'contracts/**/*.sol'",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network hardhatMainnet",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy"
  },
  "devDependencies": {
    "hardhat": "3.14.0",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "3.0.7",
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "3.0.11",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "3.1.6",
    "@nomicfoundation/hardhat-keystore": "3.0.13",
    "@nomicfoundation/hardhat-mocha": "3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-typechain": "3.1.1",
    "@nomicfoundation/hardhat-verify": "3.0.22",
    "@openzeppelin/hardhat-upgrades": "4.1.0",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "ethers": "6.17.0",
    "chai": "6.2.2",
    "mocha": "11.8.0",
    "typescript": "5.9.3",
    "solhint": "6.2.4",
    "@types/node": "22.8.5",
    "@types/mocha": "10.0.10",
    "@types/chai": "5.2.3"
  }
}
