# Development-only Azure image. It runs a private Hardhat chain and the NestJS Blockchain Server
# in one App Service container, so no public testnet funds are required.
FROM node:24-slim AS base
WORKDIR /workspace

FROM base AS deps
COPY package.json package-lock.json ./
COPY contracts/cube-nft/package.json contracts/cube-nft/package.json
COPY server/package.json server/package.json
RUN npm ci

FROM deps AS build
COPY . .
ENV NODE_OPTIONS=--max-old-space-size=1280
RUN npm run build:contracts
RUN npm run build:server
RUN chmod +x server/scripts/start-azure-hardhat.sh

# Hardhat is a development dependency, so this runtime intentionally retains the complete
# workspace dependency tree. Use server/Dockerfile for a public testnet or production deployment.
FROM build AS runtime
ENV NODE_ENV=production
ENV PORT=3100
ENV CUBE_NFT_NETWORK=localhost
ENV TRANSACTION_RPC_URL_PRIMARY=http://127.0.0.1:8545
EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||3100)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["sh", "server/scripts/start-azure-hardhat.sh"]
